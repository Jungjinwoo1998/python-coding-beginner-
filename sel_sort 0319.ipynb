   "source": [
    "def sel_sort(a):\n",
    "    k=len(a)\n",
    "    for i in range (0,k-1):\n",
    "        min_idx=i\n",
    "        for j in range (i+1,k):\n",
    "            if a[j]<a[min_idx]:\n",
    "                min_idx=j\n",
    "                a[i], a[min_idx]=a[min_idx], a[i]\n",
    "    return a"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
